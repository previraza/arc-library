{
  "name": "manicat-library",
  "version": "0.0.0",
  "private": true,
  "description": "Free, open source React components and blocks with calm motion. Install with the shadcn CLI or copy the code.",
  "license": "MIT",
  "author": "Elia Kuratli",
  "homepage": "https://uiarc.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuratlielia/arc-library.git"
  },
  "bugs": {
    "url": "https://github.com/kuratlielia/arc-library/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @manicat/docs dev",
    "build": "pnpm --filter @manicat/docs build",
    "start": "pnpm --filter @manicat/docs start",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "check:registry": "pnpm --filter manicat check:registry",
    "check": "pnpm typecheck && pnpm lint && pnpm check:registry"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "typescript": "^6.0.3"
  }
}