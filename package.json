{
  "name": "manicat-library",
  "version": "0.0.0",
  "private": true,
  "description": "Free, open source React components and blocks with calm motion. Install with the shadcn CLI or copy the code.",
  "license": "MIT",
  "author": "Elia Kuratli",
  "homepage": "https://uiarc.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kuratlielia/arc-library.git"
  },
  "bugs": {
    "url": "https://github.com/kuratlielia/arc-library/issues"
  },
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:docs": "pnpm --filter @manicat/docs dev",
    "build": "pnpm --filter @manicat/docs build",
    "start": "pnpm --filter @manicat/docs start",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "biome": "biome lint .",
    "check:registry": "pnpm --filter manicat check:registry",
    "check": "turbo run typecheck //#lint //#biome //#check:registry"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3"
  }
}