{
  "name": "manicat",
  "version": "0.0.0",
  "private": true,
  "description": "The Manicat UI registry: components, blocks and design tokens, published as a shadcn registry.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./registry.json": "./registry.json",
    "./registry/*": "./registry/*",
    "./lib/*": "./lib/*",
    "./package.json": "./package.json",
    "./frameworks.json": "./frameworks.json"
  },
  "files": [
    "registry",
    "lib",
    "registry.json",
    "frameworks.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p tsconfig.vue.json",
    "check:registry": "node scripts/check-registry.mjs && node scripts/check-parity.mjs && node scripts/check-compile.mjs",
    "build:registry": "node scripts/build-registry.mjs"
  },
  "devDependencies": {
    "@lucide/svelte": "^1.55.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bits-ui": "^2.19.5",
    "lucide-react": "^1.47.0",
    "lucide-react-native": "^1.55.0",
    "lucide-vue-next": "^1.0.0",
    "motion": "^13.4.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "~0.79.7",
    "react-native-svg": "^15.15.5",
    "reka-ui": "^2.11.0",
    "svelte": "^5.0.0",
    "typescript": "^6.0.3",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.13"
  }
}
