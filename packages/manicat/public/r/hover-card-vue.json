{"$schema":"https://ui.shadcn.com/schema/registry-item.json","name":"hover-card-vue","type":"registry:ui","title":"Hover card (Vue)","description":"Preview a person or link on hover or focus without leaving the page.","dependencies":["vue"],"registryDependencies":["https://manicat.dev/r/manicat-foundation.json"],"files":[{"path":"registry/components/hover-card/hover-card.vue","type":"registry:component","target":"@components/manicat/hover-card/hover-card.vue","content":"<script setup lang=\"ts\">\nimport { onBeforeUnmount, ref, useId } from \"vue\";\n\nconst props = withDefaults(\n  defineProps<{\n    side?: \"top\" | \"bottom\" | \"left\" | \"right\";\n    align?: \"start\" | \"center\" | \"end\";\n    openDelay?: number;\n    closeDelay?: number;\n    /** Extend the inner, named parts of the card: card. */\n    classNames?: { card?: string };\n  }>(),\n  { side: \"bottom\", align: \"start\", openDelay: 300, closeDelay: 150 },\n);\n\nconst id = useId();\nconst open = ref(false);\nlet timer: ReturnType<typeof setTimeout> | undefined;\n\n// Moving from the trigger onto the card keeps it open: leaving either only starts the close delay.\nfunction show() {\n  clearTimeout(timer);\n  timer = setTimeout(() => (open.value = true), props.openDelay);\n}\n\nfunction hide() {\n  clearTimeout(timer);\n  timer = setTimeout(() => (open.value = false), props.closeDelay);\n}\n\nonBeforeUnmount(() => clearTimeout(timer));\n</script>\n\n<template>\n  <span class=\"mc-hovercard\" @pointerenter=\"show\" @pointerleave=\"hide\" @focusin=\"show\" @focusout=\"hide\" @keydown.esc=\"open = false\">\n    <span :aria-describedby=\"open ? id : undefined\"><slot /></span>\n    <div v-if=\"open\" :id=\"id\" role=\"dialog\" :data-side=\"side\" :data-align=\"align\" :class=\"['mc-hovercard__card', classNames?.card]\">\n      <slot name=\"content\" />\n    </div>\n  </span>\n</template>\n\n<style>\n/* Reads the Manicat UI tokens from foundation.css, so import that stylesheet once in your app. */\n.mc-hovercard { position: relative; display: inline-flex; }\n.mc-hovercard__card { position: absolute; z-index: 70; width: 18rem; padding: var(--space-4); border: 1px solid var(--border); border-radius: var(--radius-panel); background: var(--surface-raised); box-shadow: var(--shadow-floating); animation: mc-hovercard-in .18s var(--ease-enter) both; }\n.mc-hovercard__card[data-side=\"bottom\"] { top: calc(100% + 8px); } .mc-hovercard__card[data-side=\"top\"] { bottom: calc(100% + 8px); }\n.mc-hovercard__card[data-side=\"right\"] { left: calc(100% + 8px); top: 0; } .mc-hovercard__card[data-side=\"left\"] { right: calc(100% + 8px); top: 0; }\n.mc-hovercard__card[data-align=\"start\"][data-side=\"bottom\"], .mc-hovercard__card[data-align=\"start\"][data-side=\"top\"] { left: 0; }\n.mc-hovercard__card[data-align=\"end\"][data-side=\"bottom\"], .mc-hovercard__card[data-align=\"end\"][data-side=\"top\"] { right: 0; }\n.mc-hovercard__card[data-align=\"center\"][data-side=\"bottom\"], .mc-hovercard__card[data-align=\"center\"][data-side=\"top\"] { left: 50%; margin-left: -9rem; }\n@keyframes mc-hovercard-in { from { opacity: 0; transform: translateY(-4px) scale(.98); } to { opacity: 1; transform: none; } }\n@media (prefers-reduced-motion: reduce) { .mc-hovercard__card { animation: none; } }\n</style>\n"}],"meta":{"tier":"free","kind":"component","docs":"https://uiarc.dev/components/hover-card","markdown":"https://uiarc.dev/components/hover-card/markdown","tags":["preview","people","popover"],"framework":"vue","port":"hover-card"}}