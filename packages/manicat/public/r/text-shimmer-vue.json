{"$schema":"https://ui.shadcn.com/schema/registry-item.json","name":"text-shimmer-vue","type":"registry:ui","title":"Text shimmer (Vue)","description":"Show ongoing work with a calm light across the words.","dependencies":["vue"],"registryDependencies":["https://manicat.dev/r/manicat-foundation.json"],"files":[{"path":"registry/components/text-shimmer/text-shimmer.vue","type":"registry:component","target":"@components/manicat/text-shimmer/text-shimmer.vue","content":"<script setup lang=\"ts\">\nwithDefaults(\n  defineProps<{\n    as?: \"span\" | \"p\" | \"div\" | \"h2\" | \"h3\" | \"h4\";\n    /** Turn the shimmer off when the work is done. */\n    active?: boolean;\n    /** Seconds for one pass. */\n    duration?: number;\n    /** Extend the inner, named parts of the shimmer: stage or label. */\n    classNames?: { stage?: string; label?: string };\n  }>(),\n  { as: \"span\", active: true, duration: 1.8 },\n);\n</script>\n\n<template>\n  <component :is=\"as\" :class=\"['mc-shimmer', classNames?.stage]\" :data-active=\"active || undefined\" :aria-busy=\"active || undefined\" :style=\"{ '--mc-duration': `${duration}s` }\">\n    <span :class=\"['mc-shimmer__label', classNames?.label]\"><slot /></span>\n  </component>\n</template>\n\n<style>\n/* Reads the Manicat UI tokens from foundation.css, so import that stylesheet once in your app. */\n.mc-shimmer { display: inline-block; }\n.mc-shimmer__label { color: var(--text-muted); }\n.mc-shimmer[data-active] .mc-shimmer__label { color: transparent; background: linear-gradient(100deg, var(--text-muted) 35%, var(--foreground) 50%, var(--text-muted) 65%) 100% 0 / 250% 100% no-repeat; -webkit-background-clip: text; background-clip: text; animation: mc-shimmer var(--mc-duration, 1.8s) linear infinite; }\n@keyframes mc-shimmer { to { background-position: 0 0; } }\n@media (prefers-reduced-motion: reduce) { .mc-shimmer[data-active] .mc-shimmer__label { animation: none; color: var(--text-secondary); background: none; } }\n</style>\n"}],"meta":{"tier":"free","kind":"component","docs":"https://uiarc.dev/components/text-shimmer","markdown":"https://uiarc.dev/components/text-shimmer/markdown","tags":["text","motion","loading"],"framework":"vue","port":"text-shimmer"}}