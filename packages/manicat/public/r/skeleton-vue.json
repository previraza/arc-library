{"$schema":"https://ui.shadcn.com/schema/registry-item.json","name":"skeleton-vue","type":"registry:ui","title":"Skeleton (Vue)","description":"Reserve space while content is still loading.","dependencies":["vue"],"registryDependencies":["https://manicat.dev/r/manicat-foundation.json"],"files":[{"path":"registry/components/skeleton/skeleton.vue","type":"registry:component","target":"@components/manicat/skeleton/skeleton.vue","content":"<script setup lang=\"ts\">\nwithDefaults(\n  defineProps<{\n    /** Accessible name announced while loading. */\n    label?: string;\n    lines?: number;\n    avatar?: boolean;\n    /** Shows the slot instead of the placeholder once false. */\n    loading?: boolean;\n    /** Extend the inner, named parts of the skeleton: avatar, lines or line. */\n    classNames?: { avatar?: string; lines?: string; line?: string };\n  }>(),\n  { label: \"Loading\", lines: 3, avatar: false, loading: true },\n);\n</script>\n\n<template>\n  <slot v-if=\"!loading && $slots.default\" />\n  <div v-else class=\"mc-skeleton\" role=\"status\" :aria-label=\"label\" aria-busy=\"true\">\n    <span v-if=\"avatar\" :class=\"['mc-skeleton__block', 'mc-skeleton__avatar', classNames?.avatar]\" />\n    <div :class=\"['mc-skeleton__lines', classNames?.lines]\">\n      <span v-for=\"index in lines\" :key=\"index\" :class=\"['mc-skeleton__block', 'mc-skeleton__line', classNames?.line]\" :style=\"{ '--index': index - 1 }\" />\n    </div>\n  </div>\n</template>\n\n<style>\n/* Reads the Manicat UI tokens from foundation.css, so import that stylesheet once in your app. */\n.mc-skeleton { display: flex; width: 100%; min-width: 0; align-items: flex-start; gap: var(--space-4); }\n/* A calm, finite pulse: each block dims a beat after the one above it, then rests after about 20 seconds. */\n.mc-skeleton__block { display: block; flex: 0 0 auto; border-radius: var(--radius-control); background: color-mix(in oklab, var(--border-strong) 38%, var(--surface)); animation: mc-skeleton-pulse 1.8s var(--ease-in-out) calc(var(--index, 0) * 90ms) 11 both; }\n.mc-skeleton__avatar { width: var(--control-height-md); height: var(--control-height-md); border-radius: var(--radius-pill); }\n.mc-skeleton__lines { display: grid; flex: 1; gap: var(--space-3); padding-top: var(--space-1); }\n.mc-skeleton__line { width: 100%; height: var(--space-3); }\n.mc-skeleton__line:first-child { width: 48%; height: var(--space-4); }\n.mc-skeleton__line:last-child { width: 72%; }\n@keyframes mc-skeleton-pulse { 0%, 100% { opacity: 1; } 50% { opacity: .52; } }\n@media (prefers-reduced-motion: reduce) { .mc-skeleton__block { animation: none; } }\n</style>\n"}],"meta":{"tier":"free","kind":"component","docs":"https://uiarc.dev/components/skeleton","markdown":"https://uiarc.dev/components/skeleton/markdown","tags":["loading","status"],"framework":"vue","port":"skeleton"}}