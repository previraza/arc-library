{"$schema":"https://ui.shadcn.com/schema/registry-item.json","name":"date-range-picker-vue","type":"registry:ui","title":"Date range picker (Vue)","description":"A range picker that grows from its trigger into two months with presets and a stretching range highlight.","dependencies":["vue"],"registryDependencies":["https://manicat.dev/r/manicat-foundation.json"],"files":[{"path":"registry/components/date-range-picker/date-range-picker.vue","type":"registry:component","target":"@components/manicat/date-range-picker/date-range-picker.vue","content":"<script lang=\"ts\">\nimport { addDays, startOfDay, startOfMonth } from \"../lib/calendar\";\n\nconst defaultPresets: DateRangePreset[] = [\n  { label: \"Last 7 days\", range: (today) => ({ start: addDays(startOfDay(today), -6), end: startOfDay(today) }) },\n  { label: \"Last 30 days\", range: (today) => ({ start: addDays(startOfDay(today), -29), end: startOfDay(today) }) },\n  { label: \"This month\", range: (today) => ({ start: startOfMonth(today), end: startOfDay(today) }) },\n];\n</script>\n\n<script setup lang=\"ts\">\nimport { computed, onBeforeUnmount, onMounted, ref, useId } from \"vue\";\nimport Calendar from \"./range-calendar.vue\";\n\nexport interface DateRange {\n  start: Date;\n  end: Date;\n}\n\nexport interface DateRangePreset {\n  label: string;\n  range: (today: Date) => DateRange;\n}\n\nconst props = withDefaults(\n  defineProps<{\n    label?: string;\n    placeholder?: string;\n    presets?: DateRangePreset[];\n    minDate?: Date;\n    maxDate?: Date;\n    weekStartsOn?: 0 | 1;\n    locale?: string;\n    /** Extend the inner, named parts of the picker: trigger, popover or preset. */\n    classNames?: { trigger?: string; popover?: string; preset?: string };\n  }>(),\n  { label: \"Date range\", placeholder: \"Select a range\", presets: () => defaultPresets, weekStartsOn: 0, locale: \"en-US\" },\n);\n\n/** `v-model` binds the range. Two clicks pick it: the start, then the end. */\nconst model = defineModel<DateRange | null>({ default: null });\nconst id = useId();\nconst root = ref<HTMLElement>();\nconst open = ref(false);\nconst anchor = ref<Date | null>(null);\nconst hover = ref<Date | null>(null);\nconst month = ref(startOfMonth(new Date()));\nconst short = (date: Date) => date.toLocaleDateString(props.locale, { month: \"short\", day: \"numeric\", year: \"numeric\" });\n\n// While the second click is pending, the range follows the pointer.\nconst preview = computed(() => (anchor.value ? { start: anchor.value, end: hover.value && hover.value >= anchor.value ? hover.value : anchor.value } : (model.value ?? undefined)));\n\nfunction commit(range: DateRange) {\n  model.value = range;\n  anchor.value = null;\n  hover.value = null;\n  open.value = false;\n}\n\nfunction pick(date: Date | undefined) {\n  if (!date) return;\n  if (!anchor.value) return (anchor.value = date);\n  commit(date < anchor.value ? { start: date, end: anchor.value } : { start: anchor.value, end: date });\n}\n\nfunction toggle() {\n  open.value = !open.value;\n  if (open.value) month.value = startOfMonth(model.value?.start ?? new Date());\n}\n\nfunction onOutside(event: PointerEvent) {\n  if (open.value && root.value && !root.value.contains(event.target as Node)) {\n    open.value = false;\n    anchor.value = null;\n  }\n}\n\nfunction onKeydown(event: KeyboardEvent) {\n  if (event.key === \"Escape\" && open.value) {\n    open.value = false;\n    anchor.value = null;\n  }\n}\n\nonMounted(() => document.addEventListener(\"pointerdown\", onOutside));\nonBeforeUnmount(() => document.removeEventListener(\"pointerdown\", onOutside));\n</script>\n\n<template>\n  <div ref=\"root\" class=\"mc-range\" @keydown=\"onKeydown\">\n    <label :id=\"`${id}-label`\" class=\"mc-range__label\">{{ label }}</label>\n    <div class=\"mc-range__anchor\">\n      <button type=\"button\" :class=\"['mc-range__trigger', classNames?.trigger]\" :aria-labelledby=\"`${id}-label`\" aria-haspopup=\"dialog\" :aria-expanded=\"open\" @click=\"toggle\">\n        <span :class=\"{ 'mc-range__placeholder': !model }\">{{ model ? `${short(model.start)} – ${short(model.end)}` : placeholder }}</span>\n        <svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect width=\"18\" height=\"18\" x=\"3\" y=\"4\" rx=\"2\" /><path d=\"M16 2v4M8 2v4M3 10h18\" /></svg>\n      </button>\n      <div v-if=\"open\" role=\"dialog\" aria-label=\"Choose date range\" :class=\"['mc-range__popover', classNames?.popover]\">\n        <div class=\"mc-range__presets\">\n          <button v-for=\"preset in presets\" :key=\"preset.label\" type=\"button\" :class=\"['mc-range__preset', classNames?.preset]\" @click=\"commit(preset.range(new Date()))\">{{ preset.label }}</button>\n        </div>\n        <p class=\"mc-range__hint\">{{ anchor ? \"Choose the end date\" : \"Choose the start date\" }}</p>\n        <Calendar v-model:month=\"month\" :locale=\"locale\" :week-starts-on=\"weekStartsOn\" :min-date=\"minDate\" :max-date=\"maxDate\" :range=\"preview\" @update:model-value=\"pick\" @hover=\"hover = $event\" />\n      </div>\n    </div>\n  </div>\n</template>\n\n<style>\n/* Reads the Manicat UI tokens from foundation.css, so import that stylesheet once in your app. */\n.mc-range { display: grid; gap: var(--space-2); min-width: 0; }\n.mc-range__label { font-size: var(--text-sm); font-weight: 500; }\n.mc-range__anchor { position: relative; }\n.mc-range__trigger { box-sizing: border-box; display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); width: 100%; min-height: var(--control-height-md); padding: 0 var(--space-3); border: 1px solid var(--border); border-radius: var(--radius-control); background: var(--surface); color: var(--foreground); font: inherit; font-size: var(--text-sm); text-align: left; cursor: pointer; }\n@media (hover: hover) and (pointer: fine) { .mc-range__trigger:hover { border-color: var(--border-strong); background: var(--surface-muted); } }\n.mc-range__trigger[aria-expanded=\"true\"], .mc-range__trigger:focus-visible { border-color: var(--border-strong); outline: none; }\n.mc-range__placeholder { color: var(--text-muted); }\n.mc-range__popover { position: absolute; z-index: 1000; top: calc(100% + 6px); left: 0; width: min(22rem, calc(100vw - 2rem)); padding: var(--space-4); border: 1px solid var(--border); border-radius: var(--radius-panel); background: var(--surface-raised); box-shadow: var(--shadow-floating); animation: mc-range-in .18s var(--ease-enter) both; }\n.mc-range__presets { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: var(--space-3); }\n.mc-range__preset { padding: 4px 12px; border: 1px solid var(--border); border-radius: var(--radius-pill); background: transparent; color: var(--foreground); font: inherit; font-size: var(--text-xs); font-weight: 500; cursor: pointer; }\n@media (hover: hover) and (pointer: fine) { .mc-range__preset:hover { background: var(--surface-muted); } }\n.mc-range__hint { margin: 0 0 4px; color: var(--text-muted); font-size: var(--text-xs); }\n@keyframes mc-range-in { from { opacity: 0; transform: translateY(-4px) scale(.98); } to { opacity: 1; transform: none; } }\n@media (prefers-reduced-motion: reduce) { .mc-range__popover { animation: none; } }\n</style>\n"},{"path":"registry/components/date-range-picker/range-calendar.vue","type":"registry:component","target":"@components/manicat/date-range-picker/range-calendar.vue","content":"<script setup lang=\"ts\">\nimport { computed, nextTick, ref, useId } from \"vue\";\nimport { addDays, addMonths, isDisabled, monthGrid, monthLabel, sameDay, startOfMonth, weekdayLabels } from \"../lib/calendar\";\nimport type { CalendarDateMatcher } from \"../lib/calendar\";\n\nconst props = withDefaults(\n  defineProps<{\n    minDate?: Date;\n    maxDate?: Date;\n    disabledDates?: CalendarDateMatcher;\n    locale?: string;\n    weekStartsOn?: 0 | 1;\n    showToday?: boolean;\n    /** Draws a range between these two days (used by the date range picker). */\n    range?: { start: Date; end?: Date | null };\n    /** Extend the inner, named parts of the calendar: header, title, nav, weekday, day, selected or today. */\n    classNames?: { header?: string; title?: string; nav?: string; weekday?: string; day?: string; selected?: string; today?: string };\n  }>(),\n  { locale: \"en-US\", weekStartsOn: 0, showToday: true },\n);\n\n/** `v-model` binds the selected day; `v-model:month` binds the month on show. */\nconst value = defineModel<Date | undefined>();\nconst month = defineModel<Date>(\"month\", { default: () => startOfMonth(new Date()) });\nconst emit = defineEmits<{ hover: [date: Date] }>();\nconst id = useId();\nconst focused = ref<Date>();\nconst today = new Date();\n\nconst days = computed(() => monthGrid(month.value, props.weekStartsOn));\nconst weekdays = computed(() => weekdayLabels(props.locale, props.weekStartsOn));\n\nconst limits = computed(() => ({ minDate: props.minDate, maxDate: props.maxDate, disabledDates: props.disabledDates }));\nconst inRange = (date: Date) => Boolean(props.range?.start && props.range.end && date >= props.range.start && date <= props.range.end);\n\nfunction choose(date: Date) {\n  if (isDisabled(date, limits.value)) return;\n  value.value = date;\n  if (date.getMonth() !== month.value.getMonth()) month.value = startOfMonth(date);\n}\n\n// Arrow keys move through days, PageUp/PageDown through months, as in a date grid.\nasync function onKeydown(event: KeyboardEvent, date: Date) {\n  const step = { ArrowLeft: -1, ArrowRight: 1, ArrowUp: -7, ArrowDown: 7 }[event.key as \"ArrowLeft\"];\n  let next: Date | undefined;\n  if (step) next = addDays(date, step);\n  else if (event.key === \"PageUp\") next = addMonths(date, -1);\n  else if (event.key === \"PageDown\") next = addMonths(date, 1);\n  else if (event.key === \"Enter\" || event.key === \" \") {\n    event.preventDefault();\n    return choose(date);\n  } else return;\n  event.preventDefault();\n  if (next.getMonth() !== month.value.getMonth()) month.value = startOfMonth(next);\n  focused.value = next;\n  await nextTick();\n  document.getElementById(`${id}-${next.getFullYear()}-${next.getMonth()}-${next.getDate()}`)?.focus();\n}\n</script>\n\n<template>\n  <div class=\"mc-cal\">\n    <div :class=\"['mc-cal__header', classNames?.header]\">\n      <button type=\"button\" :class=\"['mc-cal__nav', classNames?.nav]\" aria-label=\"Previous month\" @click=\"month = addMonths(month, -1)\">\n        <svg viewBox=\"0 0 16 16\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m10 3.5-4.5 4.5L10 12.5\" /></svg>\n      </button>\n      <h3 :class=\"['mc-cal__title', classNames?.title]\" aria-live=\"polite\">{{ monthLabel(month, locale) }}</h3>\n      <button type=\"button\" :class=\"['mc-cal__nav', classNames?.nav]\" aria-label=\"Next month\" @click=\"month = addMonths(month, 1)\">\n        <svg viewBox=\"0 0 16 16\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m6 3.5 4.5 4.5L6 12.5\" /></svg>\n      </button>\n    </div>\n    <div class=\"mc-cal__grid\" role=\"grid\" :aria-label=\"monthLabel(month, locale)\">\n      <span v-for=\"label in weekdays\" :key=\"label\" role=\"columnheader\" :class=\"['mc-cal__weekday', classNames?.weekday]\">{{ label.slice(0, 2) }}</span>\n      <button\n        v-for=\"date in days\"\n        :id=\"`${id}-${date.getFullYear()}-${date.getMonth()}-${date.getDate()}`\"\n        :key=\"date.toISOString()\"\n        type=\"button\"\n        role=\"gridcell\"\n        :class=\"['mc-cal__day', classNames?.day, sameDay(date, value) || sameDay(date, range?.start) || sameDay(date, range?.end) ? classNames?.selected : '']\"\n        :aria-selected=\"sameDay(date, value) || undefined\"\n        :aria-label=\"date.toDateString()\"\n        :tabindex=\"sameDay(date, focused ?? value ?? today) ? 0 : -1\"\n        :disabled=\"isDisabled(date, limits)\"\n        :data-outside=\"date.getMonth() !== month.getMonth() || undefined\"\n        :data-today=\"(showToday && sameDay(date, today)) || undefined\"\n        :data-selected=\"sameDay(date, value) || sameDay(date, range?.start) || sameDay(date, range?.end) || undefined\"\n        :data-in-range=\"inRange(date) || undefined\"\n        @click=\"choose(date)\"\n        @pointerenter=\"emit('hover', date)\"\n        @keydown=\"onKeydown($event, date)\"\n      >\n        {{ date.getDate() }}\n      </button>\n    </div>\n  </div>\n</template>\n\n<style>\n/* Reads the Manicat UI tokens from foundation.css, so import that stylesheet once in your app. */\n.mc-cal { width: 100%; max-width: 20rem; }\n.mc-cal__header { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-2); }\n.mc-cal__title { margin: 0; font-size: var(--text-sm); font-weight: 600; }\n.mc-cal__nav { display: grid; place-items: center; width: 32px; height: 32px; border: 0; border-radius: var(--radius-pill); background: transparent; color: var(--text-secondary); cursor: pointer; }\n@media (hover: hover) and (pointer: fine) { .mc-cal__nav:hover { background: var(--surface-muted); color: var(--foreground); } }\n.mc-cal__grid { display: grid; grid-template-columns: repeat(7, 1fr); }\n.mc-cal__weekday { padding: 6px 0; color: var(--text-muted); font-size: var(--text-xs); text-align: center; }\n.mc-cal__day { aspect-ratio: 1; display: grid; place-items: center; border: 1px solid transparent; border-radius: var(--radius-pill); background: transparent; color: var(--foreground); font: inherit; font-size: var(--text-sm); font-variant-numeric: tabular-nums; cursor: pointer; }\n.mc-cal__day[data-outside] { color: var(--text-muted); }\n.mc-cal__day[data-today] { border-color: var(--border-strong); }\n.mc-cal__day[data-in-range] { background: var(--surface-muted); border-radius: 0; }\n@media (hover: hover) and (pointer: fine) { .mc-cal__day:hover:not(:disabled, [data-selected]) { background: var(--surface-muted); } }\n.mc-cal__day[data-selected] { border-radius: var(--radius-pill); background: var(--control-on); color: var(--control-glyph); }\n.mc-cal__day:disabled { opacity: .4; cursor: not-allowed; }\n.mc-cal__day:focus-visible { outline: 2px solid var(--focus-ring); outline-offset: -2px; }\n</style>\n"},{"path":"lib/calendar.ts","type":"registry:lib","target":"@components/manicat/lib/calendar.ts","content":"/**\n * Date helpers shared by the calendar, date picker and date range picker ports (React Native and Vue). Pure functions on\n * `Date`, no dependency: a month is always laid out as six weeks so the grid never changes height between months.\n */\n\nexport type CalendarDateMatcher = (date: Date) => boolean;\n\nexport interface CalendarLimits {\n  minDate?: Date;\n  maxDate?: Date;\n  disabledDates?: CalendarDateMatcher;\n}\n\nexport const startOfDay = (date: Date) => new Date(date.getFullYear(), date.getMonth(), date.getDate());\nexport const startOfMonth = (date: Date) => new Date(date.getFullYear(), date.getMonth(), 1);\nexport const addMonths = (date: Date, count: number) => new Date(date.getFullYear(), date.getMonth() + count, 1);\nexport const addDays = (date: Date, count: number) => new Date(date.getFullYear(), date.getMonth(), date.getDate() + count);\n\nexport const sameDay = (a?: Date | null, b?: Date | null) =>\n  Boolean(a && b) && a!.getFullYear() === b!.getFullYear() && a!.getMonth() === b!.getMonth() && a!.getDate() === b!.getDate();\n\n/** The 42 days shown for a month, starting on `weekStartsOn` (0 is Sunday, 1 is Monday). */\nexport function monthGrid(month: Date, weekStartsOn: 0 | 1 = 0): Date[] {\n  const first = startOfMonth(month);\n  const offset = (first.getDay() - weekStartsOn + 7) % 7;\n  return Array.from({ length: 42 }, (_, index) => addDays(first, index - offset));\n}\n\n/** Short weekday names in column order, in the given locale. */\nexport function weekdayLabels(locale = \"en-US\", weekStartsOn: 0 | 1 = 0): string[] {\n  // 2024-01-07 was a Sunday.\n  return Array.from({ length: 7 }, (_, index) => new Date(2024, 0, 7 + ((index + weekStartsOn) % 7)).toLocaleDateString(locale, { weekday: \"short\" }));\n}\n\nexport const monthLabel = (month: Date, locale = \"en-US\") => month.toLocaleDateString(locale, { month: \"long\", year: \"numeric\" });\n\nexport function isDisabled(date: Date, { minDate, maxDate, disabledDates }: CalendarLimits): boolean {\n  const day = startOfDay(date).getTime();\n  return Boolean((minDate && day < startOfDay(minDate).getTime()) || (maxDate && day > startOfDay(maxDate).getTime()) || disabledDates?.(date));\n}\n\nexport const sameMonth = (a?: Date | null, b?: Date | null) => Boolean(a && b) && a!.getFullYear() === b!.getFullYear() && a!.getMonth() === b!.getMonth();\n/** Moves by whole months and keeps the day, clamped to the shorter month: January 31 plus one month is February 28. */\nexport const shiftMonths = (date: Date, amount: number) => new Date(date.getFullYear(), date.getMonth() + amount, Math.min(date.getDate(), new Date(date.getFullYear(), date.getMonth() + amount + 1, 0).getDate()));\nexport const isBefore = (a: Date, b?: Date) => Boolean(b && startOfDay(a).getTime() < startOfDay(b).getTime());\nexport const isAfter = (a: Date, b?: Date) => Boolean(b && startOfDay(a).getTime() > startOfDay(b).getTime());\nexport const dateKey = (date: Date) => `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, \"0\")}-${String(date.getDate()).padStart(2, \"0\")}`;\n"}],"meta":{"tier":"free","kind":"component","docs":"https://uiarc.dev/components/date-range-picker","markdown":"https://uiarc.dev/components/date-range-picker/markdown","tags":["inputs","new"],"framework":"vue","port":"date-range-picker"}}