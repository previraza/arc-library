{"$schema":"https://ui.shadcn.com/schema/registry-item.json","name":"file-upload-vue","type":"registry:block","title":"File upload (Vue)","description":"A complete file selection flow with constraints, progress, and error feedback.","dependencies":["vue"],"registryDependencies":["https://manicat.dev/r/manicat-foundation.json"],"files":[{"path":"registry/components/file-upload/file-upload.vue","type":"registry:component","target":"@components/manicat/file-upload/file-upload.vue","content":"<script setup lang=\"ts\">\nimport { ref, useId } from \"vue\";\n\nexport interface FileUploadItem {\n  id: string;\n  file: File;\n  error?: string;\n}\n\nconst props = withDefaults(\n  defineProps<{\n    accept?: string;\n    disabled?: boolean;\n    label?: string;\n    description?: string;\n    multiple?: boolean;\n    /** Largest file in bytes; bigger ones are listed with an error. */\n    maxSize?: number;\n    /** Extend the inner, named parts of the upload: button, item or name. */\n    classNames?: { button?: string; item?: string; name?: string };\n  }>(),\n  { disabled: false, label: \"Upload a file\", multiple: false },\n);\n\n/** `v-model` binds the chosen files. Uploading them is up to you. */\nconst files = defineModel<FileUploadItem[]>({ default: () => [] });\nconst id = useId();\nconst input = ref<HTMLInputElement>();\n\nconst size = (bytes: number) => (bytes >= 1_048_576 ? `${(bytes / 1_048_576).toFixed(1)} MB` : `${Math.max(1, Math.round(bytes / 1024))} KB`);\n\nfunction onChange(event: Event) {\n  const target = event.target as HTMLInputElement;\n  const chosen = [...(target.files ?? [])].map((file, index): FileUploadItem => ({ id: `f-${Date.now()}-${index}`, file, error: props.maxSize && file.size > props.maxSize ? `Larger than ${size(props.maxSize)}` : undefined }));\n  files.value = props.multiple ? [...files.value, ...chosen] : chosen.slice(0, 1);\n  target.value = \"\";\n}\n</script>\n\n<template>\n  <div class=\"mc-upload\">\n    <input :id=\"id\" ref=\"input\" type=\"file\" hidden :accept=\"accept\" :multiple=\"multiple\" :disabled=\"disabled\" @change=\"onChange\" />\n    <button type=\"button\" :class=\"['mc-upload__button', classNames?.button]\" :disabled=\"disabled\" @click=\"input?.click()\">{{ label }}</button>\n    <p v-if=\"description\" class=\"mc-upload__description\">{{ description }}</p>\n    <ul class=\"mc-upload__list\" aria-live=\"polite\">\n      <li v-for=\"item in files\" :key=\"item.id\" :class=\"['mc-upload__item', classNames?.item]\" :data-invalid=\"item.error ? '' : undefined\">\n        <span class=\"mc-upload__copy\"><span :class=\"['mc-upload__name', classNames?.name]\">{{ item.file.name }}</span><small>{{ item.error ?? size(item.file.size) }}</small></span>\n        <button type=\"button\" class=\"mc-upload__remove\" :aria-label=\"`Remove ${item.file.name}`\" @click=\"files = files.filter((entry) => entry.id !== item.id)\">×</button>\n      </li>\n    </ul>\n  </div>\n</template>\n\n<style>\n/* Reads the Manicat UI tokens from foundation.css, so import that stylesheet once in your app. */\n.mc-upload { display: grid; gap: var(--space-2); justify-items: start; }\n.mc-upload__button { min-height: var(--control-height-md); padding: 0 var(--space-4); border: 1px solid var(--border); border-radius: var(--radius-control); background: var(--surface); color: var(--foreground); font: inherit; font-size: var(--text-sm); font-weight: 500; cursor: pointer; }\n@media (hover: hover) and (pointer: fine) { .mc-upload__button:hover:not(:disabled) { background: var(--surface-muted); } } .mc-upload__button:disabled { opacity: .5; cursor: not-allowed; }\n.mc-upload__description { margin: 0; color: var(--text-muted); font-size: var(--text-xs); }\n.mc-upload__list { display: grid; gap: var(--space-2); width: 100%; margin: 0; padding: 0; list-style: none; }\n.mc-upload__item { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-3); border: 1px solid var(--border); border-radius: var(--radius-control); } .mc-upload__item[data-invalid] { border-color: var(--danger); }\n.mc-upload__copy { display: grid; flex: 1; min-width: 0; } .mc-upload__name { overflow: hidden; font-size: var(--text-sm); text-overflow: ellipsis; white-space: nowrap; } .mc-upload__copy small { color: var(--text-muted); font-size: var(--text-xs); } .mc-upload__item[data-invalid] small { color: var(--danger); }\n.mc-upload__remove { border: 0; background: transparent; color: var(--text-muted); font: inherit; font-size: 18px; cursor: pointer; }\n</style>\n"}],"meta":{"tier":"free","kind":"block","docs":"https://uiarc.dev/components/blocks/file-upload","markdown":"https://uiarc.dev/components/blocks/file-upload/markdown","framework":"vue","port":"file-upload"}}